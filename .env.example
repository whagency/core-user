APP_NAME=user-service
APP_ENVIRONMENT=local

LOG_STDOUT_FORMAT=json
LOG_HTTP_NOT_LOGGABLE_PATHS=/api/v1/swagger
LOG_LEVEL=debug

CACHE_HOST=localhost:5701
CACHE_CLUSTER_NAME=dev-cluster

DB_HOST=localhost
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=apppassword
DB_NAME=appdb
DB_SSL_MODE=disable

SECURITY_TOKEN=

# Both are HMAC-SHA256 keys and are refused at startup below 32 characters.
# Generate, do not type: openssl rand -base64 32
#
# JWT_ACCESS_SECRET is shared with admin-service, which signs impersonation
# tokens user-service then accepts. Changing it invalidates every access token
# in flight, so a rotation signs everyone out.
JWT_ACCESS_SECRET=
OTP_SECRET_PEPPER=

# Other services that sign access tokens with JWT_ACCESS_SECRET. An access
# token must name an accepted issuer in iss; APP_NAME is always accepted and
# does not need listing. admin-service signs the token the backoffice uses for
# the notification websocket, so leaving it out stops that websocket
# authenticating.
JWT_ADDITIONAL_ISSUERS=admin-service

QUEUE_HOST=localhost
QUEUE_PORT=5672
QUEUE_USER=user
QUEUE_PASSWORD=password

AML_BOT_URL=https://kyc-api.amlbot.com
AML_BOT_API_TOKEN=test
AML_BOT_FORM_ID_BASIC=test
AML_BOT_FORM_ID_ADVANCED=test
AML_BOT_FORM_ID_PRO=test

RECAPTCHA_SECRET_KEY=

# Dumps full outbound HTTP requests and responses, provider tokens included.
# Rejected at startup outside local/dev/test.
HTTP_CLIENT_DUMP_ALL=false

# Consecutive failed sign-ins before the account is refused for a window.
# The window expires on its own; a successful sign-in or a password change
# clears the counter.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m

RESTRICTION_SERVICE_URL=http://localhost:8083
RESTRICTION_SERVICE_GRPC_URL=localhost:50054
# Transactional outbox (outbox_messages). Defaults match account-service and
# pay-service so every adopter publishes the same metric names and shares one
# dashboard — change them together, not one at a time.
CRON_OUTBOX_POOL_WORKERS=4
CRON_OUTBOX_POOL_RELAY_INTERVAL=500ms
CRON_OUTBOX_HANDLER_TIMEOUT=2s
CRON_OUTBOX_RELAY_LEASE=8s
CRON_OUTBOX_BASE_BACKOFF=30s
CRON_OUTBOX_MAX_BACKOFF=6h
CRON_OUTBOX_PRUNE_SPEC=@every 1h
CRON_OUTBOX_DELIVERED_RETENTION=48h
CRON_OUTBOX_DEAD_RETENTION=168h
CRON_OUTBOX_LAG_SPEC=@every 30s

# Retention for the tables this service grows on its own. Before this only the
# outbox was pruned; revoked_sessions alone took a row per logout and per
# refresh, which with a 15-minute access token is ~35k rows a year per active
# user.
#
# CRON_REVOKED_SESSION_RETENTION is not a free number: those rows carry the hash
# refresh-token reuse detection compares against, so it must outlast the 30-day
# refresh token. A config test pins that.
CRON_CLEANUP_SPEC=@every 1h
CRON_SESSION_RETENTION=24h
CRON_REVOKED_SESSION_RETENTION=840h
CRON_TWO_FACTOR_TOKEN_RETENTION=48h
