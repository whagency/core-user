    {
      "name": "Auth (Public)",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "try {",
                  "  var json = pm.response.json();",
                  "  if (json && json.data) {",
                  "    if (json.data.session) {",
                  "      pm.environment.set(\"accessToken\", String(json.data.session.accessToken || \"\"));",
                  "      pm.environment.set(\"refreshToken\", String(json.data.session.refreshToken || \"\"));",
                  "      pm.environment.set(\"sessionId\", String(json.data.session.sessionId || \"\"));",
                  "    }",
                  "    pm.environment.set(\"loginRequires2FA\", String(Boolean(json.data.requires2fa)));",
                  "    if (json.data.twoFactorChallenge && json.data.twoFactorChallenge.tokenUUID) {",
                  "      pm.environment.set(\"loginChallengeTokenUUID\", String(json.data.twoFactorChallenge.tokenUUID));",
                  "    }",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{userIdentifier}}\",\n  \"password\": \"{{userPassword}}\",\n  \"recaptcha\": \"{{userRecaptcha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{userBaseUrl}}/api/v1/auth/login"
