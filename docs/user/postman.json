    {
      "name": "Users (Public)",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "try {",
                  "  var json = pm.response.json();",
                  "  if (json && json.data && json.data.tokenUUID) {",
                  "    pm.environment.set(\"registrationTokenUUID\", String(json.data.tokenUUID));",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contact\": {\n    \"type\": \"email\",\n    \"value\": \"{{userIdentifier}}\"\n  },\n  \"password\": \"{{userPassword}}\",\n  \"recaptcha\": \"{{userRecaptcha}}\"\n}",
